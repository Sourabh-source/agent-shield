# AgentGuard Frontend Environment Configuration

# Backend API URL (for server-side proxy requests only)
BACKEND_URL=http://127.0.0.1:8000

# Server-only API key for backend authentication.
# CRITICAL SECURITY RULE:
# This variable is SERVER-ONLY and must NEVER be exposed to the browser.
# DO NOT prefix this variable with NEXT_PUBLIC_.
# Must match an active key in backend/config.py API_KEYS (e.g. test-api-key).
AGENTGUARD_API_KEY=test-api-key
