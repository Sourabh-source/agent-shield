# AgentGuard Backend (Member 2) Environment Configuration

# Optional Gemini API Key for dynamic LLM planning (falls back to deterministic planner if omitted)
GEMINI_API_KEY=

# Maximum automated recovery retries before reporting VERIFIED_FAILURE
MAX_RETRIES=2

# Default execution timeout per command in seconds
DEFAULT_TIMEOUT_SECONDS=60

# Base directory for cloning repositories and running builds
WORKSPACE_BASE_DIR=./workspaces

# Toggle standalone mock verifier for local testing/demo (set to true if Member 3 engine not running)
MOCK_VERIFIER=true

# URL of Member 3's Evidence Verification Engine (when running externally)
MEMBER3_VERIFIER_URL=
